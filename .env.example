# Copy to .env and fill in. Never commit .env.

# Hindsight (https://ui.hindsight.vectorize.io, promo MEMHACK99)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_LIVE=memoryops-live
HINDSIGHT_BANK_SEEDED=memoryops-seeded

# LLM: OpenAI primary (https://platform.openai.com), Groq fallback (https://console.groq.com)
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=none  # required for tool calling + temperature=0 (measured)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-5.4-mini
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Spend tracking: every LLM call is logged to USAGE_DB_PATH; calls stop at the cap
USAGE_DB_PATH=./data/usage.db
LLM_SPEND_CAP_USD=10

# Langfuse (https://cloud.langfuse.com or https://us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Simulator / agent
SIM_SPEED=10
VERIFY_WINDOW_SIM_S=180
ESCALATION_PENALTY_SIM_S=1800
MEMORY_MATCH_REL_RERANK=0.15
MEMORY_MATCH_MIN_RERANK=0.05
MAX_TOOL_CALLS=10
MAX_ATTEMPTS=3
LLM_CALL_BUDGET_S=45
SQLITE_PATH=./data/memoryops.db

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Public deployment (docs/DEPLOY.md)
CORS_ORIGINS=
DEMO_PASSCODE=
TRIGGER_LIMIT_PER_HOUR=
